# RustFS
LOCAL_UID=501
LOCAL_GID=20
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
S3_ENDPOINT=http://127.0.0.1:9010

# ZooKeeper: Compose и локальные клиенты используют эти порты.
ZK_PORT_1=22181
ZK_PORT_2=22182
ZK_PORT_3=22183
# Укажите ZK_HOSTS только для переопределения локальных адресов.
# ZK_HOSTS=zoo1:2181,zoo2:2181,zoo3:2181
ZK_NAMESPACE=/mapreduce-hw4

# Настройки расчёта. RUN_ID задаётся для каждого запуска,
# COORDINATOR_ID — при ручном запуске отдельного координатора.
FENCING=1
CHUNK_SIZE=250

# Задержка после чекпоинта для воспроизводимой паузы
CHUNK_DELAY=0.5
PAUSE_SECONDS=40
